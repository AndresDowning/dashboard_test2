# ── Supabase (app) ───────────────────────────────────────
# Las escribe /setup automáticamente después de crear el proyecto.
# (La autenticación con Supabase es por OAuth del navegador, no necesitas token.)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role key (SOLO servidor): crea usuarios, sube archivos y firma
# descargas. NUNCA la expongas en el cliente ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
